# COPY to supabase/.env (ignored), then set via: supabase secrets set --env-file supabase/.env
# Never commit actual credentials. SUPABASE_URL/SUPABASE_ANON_KEY are platform-provided Edge env vars.
ALLOWED_ORIGINS=https://repairpassport-utkrisht.web.app,https://repairpassport-utkrisht.firebaseapp.com,http://localhost:5173
TINYFISH_API_KEY=
# Set one exact approved HTTPS manufacturer support page. No query/hash/credentials/nondefault port.
# Supported domains: samsung.com, lg.com, bosch-home.in (with optional www).
# Path must include support, service or customer-service. Leave blank until coordinator approves a page.
MANUFACTURER_SUPPORT_URL=

# Optional structured AI review. Set an available Responses/structured-output-compatible model explicitly.
OPENAI_API_KEY=
OPENAI_MODEL=
